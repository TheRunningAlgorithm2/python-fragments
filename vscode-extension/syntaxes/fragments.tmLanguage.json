{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Python Fragments",
  "scopeName": "source.python.fragments",
  "injectionSelector": "L:source.python - (comment, string)",
  "patterns": [
    { "include": "#fragment" }
  ],
  "repository": {
    "fragment": {
      "name": "meta.fragment",
      "contentName": "meta.embedded.html.fragment",
      "begin": "<>",
      "end": "</>",
      "beginCaptures": { "0": { "name": "punctuation.definition.tag.fragment" } },
      "endCaptures": { "0": { "name": "punctuation.definition.tag.fragment" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#template-closing-tag" },
        { "include": "#closing-tag" },
        { "include": "#children-slot" },
        { "include": "#template-open-tag" },
        { "include": "#script-element" },
        { "include": "#style-element" },
        { "include": "#open-tag" },
        { "include": "#interpolation" }
      ]
    },
    "script-element": {
      "begin": "(<)(script)(?![a-zA-Z0-9_:.-])",
      "end": "(/>)|(</)(script)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "entity.name.tag.fragment" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "punctuation.definition.tag.fragment" },
        "3": { "name": "entity.name.tag.fragment" },
        "4": { "name": "punctuation.definition.tag.fragment" }
      },
      "patterns": [
        {
          "begin": "(>)",
          "end": "(?=</script\\s*>)",
          "beginCaptures": { "1": { "name": "punctuation.definition.tag.fragment" } },
          "contentName": "meta.embedded.block.javascript",
          "patterns": [
            { "include": "source.js" }
          ]
        },
        { "include": "#tag-attributes" }
      ]
    },
    "style-element": {
      "begin": "(<)(style)(?![a-zA-Z0-9_:.-])",
      "end": "(/>)|(</)(style)\\s*(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "entity.name.tag.fragment" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "punctuation.definition.tag.fragment" },
        "3": { "name": "entity.name.tag.fragment" },
        "4": { "name": "punctuation.definition.tag.fragment" }
      },
      "patterns": [
        {
          "begin": "(>)",
          "end": "(?=</style\\s*>)",
          "beginCaptures": { "1": { "name": "punctuation.definition.tag.fragment" } },
          "contentName": "meta.embedded.block.css",
          "patterns": [
            { "include": "source.css" }
          ]
        },
        { "include": "#tag-attributes" }
      ]
    },
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "template-closing-tag": {
      "match": "(</)\\s*(Template)\\s*(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "variable.language.template.fragment" },
        "3": { "name": "punctuation.definition.tag.fragment" }
      }
    },
    "closing-tag": {
      "match": "(</)([a-zA-Z][a-zA-Z0-9_-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "entity.name.tag.fragment" },
        "3": { "name": "punctuation.definition.tag.fragment" }
      }
    },
    "children-slot": {
      "match": "<Children\\.\\.\\. />",
      "name": "variable.language.children.fragment"
    },
    "template-open-tag": {
      "begin": "(<)(Template)(?![a-zA-Z0-9_-])",
      "end": "\\s*/?>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "variable.language.template.fragment" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.fragment" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },
    "open-tag": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9_-]*)",
      "end": "\\s*/?>",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.fragment" },
        "2": { "name": "entity.name.tag.fragment" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.fragment" }
      },
      "patterns": [
        { "include": "#tag-attributes" }
      ]
    },
    "tag-attributes": {
      "patterns": [
        { "include": "#interpolation" },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } }
        },
        {
          "match": "[a-zA-Z_][a-zA-Z0-9_-]*",
          "name": "entity.other.attribute-name.fragment"
        }
      ]
    },
    "interpolation": {
      "begin": "(\\{)(\\{)",
      "end": "(\\})(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.fragment" },
        "2": { "name": "punctuation.section.embedded.fragment" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.fragment" },
        "2": { "name": "punctuation.section.embedded.fragment" }
      },
      "patterns": [
        { "include": "source.python" }
      ]
    }
  }
}
