{
  "publisher": "tra-technologies-ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRunningAlgorithm2/python-fragments"
  },
  "name": "python-fragments",
  "displayName": "Python Fragments",
  "description": "LSP support for the Python Fragments transpiler",
  "version": "0.0.3",
  "license": "MIT",
  "icon": "logo.png",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "python",
    "html",
    "fragments",
    "transpiler",
    "jsx",
    "lsp"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/fragments.tmLanguage.json",
        "scopeName": "source.python.fragments",
        "injectTo": [
          "source.python"
        ],
        "embeddedLanguages": {
          "meta.embedded.html.fragment": "html",
          "meta.embedded.js.alpine": "javascript",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.css": "css"
        }
      }
    ],
    "commands": [
      {
        "command": "fragments.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Python Fragments"
      }
    ],
    "configuration": {
      "title": "Python Fragments",
      "properties": {
        "fragments.serverPath": {
          "type": "string",
          "description": "Override path to the fragments-lsp executable. By default, derived from the active Python interpreter selected in the Python extension."
        },
        "fragments.blackArgs": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Extra [Black command line options](https://black.readthedocs.io/en/stable/usage_and_configuration/the_basics.html#command-line-options) used when formatting, e.g. `-l 100 --preview`. Applied on top of `[tool.black]` in `pyproject.toml`, exactly as `fragments black` applies them. See [supported options](https://python-fragments.io/integrations/formatting/black/#options)."
        }
      }
    }
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.5",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch"
  }
}
